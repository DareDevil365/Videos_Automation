# Copy to .env (ignored). Gemini keys require confirmed free-tier projects; OpenAI API use is separately enabled.
GEMINI_API_KEY=
# Optional public video discovery and stock acquisition:
YOUTUBE_API_KEY=
PEXELS_API_KEY=

# Optional: explicitly select text_provider=openai and configure its API model.
OPENAI_API_KEY=
# Optional alternate key slots; choose a key_env in local config. No automatic rotation.
GEMINI_API_KEY_STORY=
OPENAI_API_KEY_STORY=
