{
  "type": "object",
  "properties": {
    "version": {
      "type": "integer"
    },
    "template": {
      "type": "string",
      "enum": [
        "story_stock",
        "chat_asmr",
        "server_chat",
        "cutout_cast",
        "aura_progression",
        "education_demo",
        "movie_cards",
        "illustrated_story"
      ]
    },
    "cast": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "avatar_kind": {
            "type": "string",
            "enum": [
              "cat",
              "dog",
              "human",
              "narrator"
            ]
          },
          "avatar_query": {
            "type": "string"
          },
          "voice_id": {
            "type": "string",
            "enum": [
              "af_heart",
              "af_bella",
              "am_adam",
              "am_michael",
              "bm_george"
            ]
          },
          "costume": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "speaker",
          "role",
          "avatar_kind",
          "avatar_query",
          "voice_id",
          "costume"
        ],
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "speaker_id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "hook",
              "setup",
              "escalation",
              "clue",
              "reveal",
              "payoff",
              "question"
            ]
          },
          "background_query": {
            "type": "string"
          },
          "visual_query": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "visible_cast": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "focus_id": {
            "type": "string"
          },
          "framing": {
            "type": "string",
            "enum": [
              "wide",
              "medium",
              "closeup"
            ]
          },
          "motion": {
            "type": "string",
            "enum": [
              "hold",
              "slow_push",
              "punch",
              "pan_left",
              "pan_right"
            ]
          },
          "emotion": {
            "type": "string",
            "enum": [
              "calm",
              "concerned",
              "shocked",
              "fearful",
              "amused",
              "angry"
            ]
          },
          "pause_after": {
            "type": "number"
          },
          "sound_cue": {
            "type": "string",
            "enum": [
              "none",
              "tension",
              "drop",
              "sting"
            ]
          },
          "rank": {
            "type": "integer"
          },
          "display_title": {
            "type": "string"
          },
          "graphic": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "comparison",
                  "process",
                  "callout",
                  "timer"
                ]
              },
              "title": {
                "type": "string"
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "headings": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "Before",
                    "After",
                    "Myth",
                    "Fact"
                  ]
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "kind",
              "title",
              "labels"
            ],
            "additionalProperties": false
          },
          "speech_segments": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "pause_after": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1.2
                },
                "speed": {
                  "type": "number",
                  "minimum": 0.9,
                  "maximum": 1.15
                }
              },
              "required": [
                "text",
                "pause_after",
                "speed"
              ],
              "additionalProperties": false
            }
          },
          "thinking_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          },
          "shot_type": {
            "type": "string",
            "enum": [
              "dialogue",
              "two_shot",
              "insert"
            ]
          },
          "pose": {
            "type": "string",
            "enum": [
              "neutral",
              "talk",
              "point",
              "react"
            ]
          },
          "callout": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "none",
                  "circle_arrow"
                ]
              },
              "target": {
                "type": "string",
                "maxLength": 120
              },
              "label": {
                "type": "string",
                "maxLength": 40
              }
            },
            "required": [
              "kind",
              "target",
              "label"
            ],
            "additionalProperties": false
          },
          "reuse_purpose": {
            "type": "string",
            "enum": [
              "none",
              "detail",
              "continuity",
              "replay"
            ]
          },
          "reuse_reason": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "unit_id",
          "text",
          "speaker_id",
          "stage",
          "background_query",
          "visual_query",
          "asset_id",
          "visible_cast",
          "focus_id",
          "framing",
          "motion",
          "emotion",
          "pause_after",
          "sound_cue",
          "rank",
          "display_title"
        ],
        "additionalProperties": false
      }
    },
    "music_mood": {
      "type": "string"
    },
    "opening_promise": {
      "type": "string"
    },
    "delivered_payoff": {
      "type": "string"
    },
    "comment_question": {
      "type": "string"
    },
    "review": {
      "type": "object",
      "properties": {
        "payoff_delivered": {
          "type": "boolean"
        },
        "hook_honest": {
          "type": "boolean"
        },
        "no_invented_evidence": {
          "type": "boolean"
        },
        "continuity_consistent": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "payoff_delivered",
        "hook_honest",
        "no_invented_evidence",
        "continuity_consistent",
        "issues"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "template",
    "cast",
    "scenes",
    "music_mood",
    "opening_promise",
    "delivered_payoff",
    "comment_question",
    "review"
  ],
  "additionalProperties": false
}